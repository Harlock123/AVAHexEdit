<Project Sdk="Microsoft.NET.Sdk">
  <!-- The window: the hex view, the inspector, template and checksum panels, find and compare. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AVAHexEdit</AssemblyName>
    <RootNamespace>AVAHexEdit</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/AVAHexEdit.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <ProjectReference Include="..\AVAHexEdit.Core\AVAHexEdit.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AVAHexEdit.Tests" />
  </ItemGroup>
</Project>
